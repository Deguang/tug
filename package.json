{
  "name": "tug",
  "version": "0.1.0",
  "description": "浏览器插件上架助手 - CLI 与浏览器注入端协同工具",
  "type": "module",
  "bin": {
    "tug": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --dts --clean",
    "dev": "tsup src/cli.ts --format esm --watch",
    "start": "node dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Deguang/tug.git"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "chalk": "^5.3.0",
    "chrome-remote-interface": "^0.34.0",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "koa": "^2.15.0",
    "koa-router": "^13.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.34.0",
    "@types/js-yaml": "^4.0.9",
    "@types/koa": "^2.15.0",
    "@types/koa-router": "^7.4.8",
    "@types/node": "^22.0.0",
    "tsup": "^8.1.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
